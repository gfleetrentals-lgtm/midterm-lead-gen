# Copy this file to .env and fill in your own values.
# Never share your real .env or commit it anywhere.

# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get from https://www.reddit.com/prefs/apps -> "create app" -> choose "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=midterm-rental-lead-monitor by u/yourusername

# Optional: a Slack "Incoming Webhook" URL if you want leads posted to Slack
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
